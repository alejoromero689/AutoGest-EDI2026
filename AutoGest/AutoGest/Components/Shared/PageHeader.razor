<header class="page-header">
    <div>
        <div class="eyebrow">@Seccion</div>
        <h1>@Titulo</h1>
        <p class="text-muted mb-0">@Descripcion</p>
    </div>
    @if (ChildContent != null) { <div class="page-actions">@ChildContent</div> }
</header>
@code {
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string Descripcion { get; set; } = "";
    [Parameter] public string Seccion { get; set; } = "GESTIÓN COMERCIAL";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
