@page "/clientes/nuevo"
@page "/clientes/editar/{Id:int}"
@inherits DatosPageBase
@inject NavigationManager Navigation
<PageTitle>@(Id.HasValue ? "Editar cliente" : "Nuevo cliente") · AutoGest</PageTitle>
<PageHeader Titulo="@(Id.HasValue ? "Editar cliente" : "Nuevo cliente")" Descripcion="Un mismo contacto puede ser cliente y proveedor." Seccion="AGENDA COMERCIAL"><a href="/clientes" class="btn btn-light">Volver a clientes</a></PageHeader>
@if (Error != null) { <div class="alert alert-danger" role="alert">@Error</div> }
@if (Cargando) { <p role="status">Cargando cliente...</p> }
else if (cliente != null)
{
    <section class="panel form-panel" aria-label="Datos del cliente">
        <div class="section-heading"><h2>Datos de contacto</h2><span>* Campos obligatorios</span></div>
        <EditForm Model="cliente" OnValidSubmit="Guardar" FormName="Cliente" @key="cliente">
            <DataAnnotationsValidator /><ValidationSummary class="text-danger" />
            <fieldset disabled="@Guardando"><div class="row g-3">
                <div class="col-12 col-md-7"><label class="form-label" for="cliente-nombre">Nombre o razón social *</label><InputText id="cliente-nombre" class="form-control" @bind-Value="cliente.Nombre" maxlength="120" autocomplete="name" /><ValidationMessage For="@(() => cliente.Nombre)" /></div>
                <div class="col-12 col-md-5"><label class="form-label" for="cliente-documento">DNI / CUIT *</label><InputText id="cliente-documento" class="form-control" @bind-Value="cliente.Documento" maxlength="11" inputmode="numeric" /><div class="form-text">Sin puntos ni guiones.</div><ValidationMessage For="@(() => cliente.Documento)" /></div>
                <div class="col-12 col-md-6"><label class="form-label" for="cliente-email">Correo electrónico</label><InputText id="cliente-email" class="form-control" @bind-Value="cliente.Email" maxlength="160" type="email" autocomplete="email" /><ValidationMessage For="@(() => cliente.Email)" /></div>
                <div class="col-12 col-md-6"><label class="form-label" for="cliente-telefono">Teléfono</label><InputText id="cliente-telefono" class="form-control" @bind-Value="cliente.Telefono" maxlength="30" type="tel" autocomplete="tel" /><ValidationMessage For="@(() => cliente.Telefono)" /></div>
                <div class="col-12"><p class="form-text mb-0">Completá al menos un correo o teléfono para poder contactar a esta persona.</p></div>
                <div class="col-12"><label class="form-label" for="cliente-direccion">Dirección</label><InputText id="cliente-direccion" class="form-control" @bind-Value="cliente.Direccion" maxlength="200" autocomplete="street-address" /><ValidationMessage For="@(() => cliente.Direccion)" /></div>
            </div><div class="form-actions"><button type="submit" class="btn btn-primary">@(Guardando ? "Guardando..." : "Guardar cliente")</button><a href="/clientes" class="btn btn-light">Cancelar</a></div></fieldset>
        </EditForm>
    </section>
}
@code {
    [Parameter] public int? Id { get; set; }
    private Cliente? cliente;
    protected override bool Reactivo => false;
    protected override async Task CargarAsync() { cliente = Id.HasValue ? await Gestion.ClienteAsync(Id.Value) : new Cliente(); if (cliente == null) Error = "El cliente no existe."; }
    private Task Guardar() => Ejecutar(async () => { await Gestion.GuardarClienteAsync(cliente!); Navigation.NavigateTo("/clientes"); });
}
