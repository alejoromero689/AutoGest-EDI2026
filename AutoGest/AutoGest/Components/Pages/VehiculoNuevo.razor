@page "/vehiculos/nuevo"
@page "/vehiculos/editar/{Id:int}"

@using AutoGest.Data
@using AutoGest.Models
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using System.Text.RegularExpressions
@using AutoGest.Services
@using AutoGest.Components.Shared


@inject IDbContextFactory<GestoriaDbContext> DbFactory
@inject NavigationManager Navigation
@inject VehiculosState VehiculosState


<PageTitle>
    @(Id.HasValue ? "Editar vehículo - AutoGest" : "Registrar vehículo - AutoGest")
</PageTitle>

<div class="vehicle-page">

    <PageHeader Titulo="@(Id.HasValue ? "Editar vehículo" : "Nuevo vehículo")" Descripcion="Completá la información de esta unidad." Seccion="CATÁLOGO AUTOMOTOR">
        <a href="/vehiculos" class="btn btn-light">Volver a vehículos</a>
    </PageHeader>

    <section class="card form-panel">

        <div class="card-body">

            @if (cargando)
            {
                <p>Cargando marcas...</p>
            }
            else if (errorCarga is not null)
            {
                <div class="alert alert-danger" role="alert">
                    @errorCarga
                </div>
            }
            else
            {
                <EditForm Model="@vehiculo"
                          OnValidSubmit="GuardarVehiculo"
                          FormName="NuevoVehiculo">

                    <DataAnnotationsValidator />

                    <ValidationSummary class="text-danger" />

                    @if (errorGuardado is not null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorGuardado
                        </div>
                    }

                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <label class="form-label" for="vehiculo-marcaid">Marca</label>

                            <InputSelect class="form-select"
                                         id="vehiculo-marcaid" @bind-Value="vehiculo.MarcaId">

                                <option value="0">
                                    Seleccioná una marca
                                </option>

                                @foreach (var marca in marcas)
                                {
                                    <option value="@marca.Id">
                                        @marca.Nombre
                                    </option>
                                }

                            </InputSelect>

                            <ValidationMessage
                                For="@(() => vehiculo.MarcaId)" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" for="vehiculo-modelo">Modelo</label>

                            <InputText class="form-control"
                                       id="vehiculo-modelo" @bind-Value="vehiculo.Modelo" />

                            <ValidationMessage
                                For="@(() => vehiculo.Modelo)" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" for="vehiculo-anio">Año</label>

                            <InputNumber class="form-control"
                                         id="vehiculo-anio" @bind-Value="vehiculo.Anio" />

                            <ValidationMessage
                                For="@(() => vehiculo.Anio)" />
                        </div>


                        <div class="col-12 col-md-6">
    <label class="form-label" for="precio">
        Precio
    </label>

                            <InputNumber id="precio"
                                         class="form-control"
                                         @bind-Value="vehiculo.Precio"
                                         step="0.01" />

    <ValidationMessage
        For="@(() => vehiculo.Precio)" />
</div>



                        <div class="col-12">

                            <div class="form-check">

                                <InputCheckbox
                                    class="form-check-input"
                                    id="vehiculo-usado" @bind-Value="vehiculo.EsUsado" />

                                <label class="form-check-label" for="vehiculo-usado">
                                    ¿Es un vehículo usado?
                                </label>

                            </div>

                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" for="vehiculo-kilometraje">Kilometraje</label>

                            <InputNumber class="form-control"
                                         id="vehiculo-kilometraje" @bind-Value="vehiculo.Kilometraje" />

                            <ValidationMessage
                                For="@(() => vehiculo.Kilometraje)" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" for="vehiculo-patente">Patente</label>

                            <InputText class="form-control"
                                       id="vehiculo-patente" @bind-Value="vehiculo.Patente" />

                            <ValidationMessage
                                For="@(() => vehiculo.Patente)" />
                        </div>

                    </div>

                    <div class="d-flex gap-2 mt-4">

                        <button type="submit"
                                class="btn btn-success"
                                disabled="@guardando">
                            @(guardando ? "Guardando..." : (Id.HasValue ? "Guardar cambios" : "Guardar vehículo"))
                        </button>

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="Volver">
                            Cancelar
                        </button>

                    </div>

                </EditForm>
            }

        </div>

    </section>

</div>

@code {


    [Parameter]
    public int? Id { get; set; }


    private Vehiculo vehiculo = new();

    private List<Marca> marcas = new();

    private bool cargando = true;
    private bool guardando = false;

    private string? errorCarga;
    private string? errorGuardado;


    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        errorCarga = null;
        errorGuardado = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            marcas = await db.Marcas
                .AsNoTracking()
                .OrderBy(m => m.Nombre)
                .ToListAsync();

            if (Id.HasValue)
            {
                var encontrado = await db.Vehiculos
                    .AsNoTracking()
                    .FirstOrDefaultAsync(v => v.Id == Id.Value);

                if (encontrado is null)
                {
                    errorCarga = "El vehículo no existe.";
                    return;
                }

                vehiculo = encontrado;
            }
            else
            {
                vehiculo = new Vehiculo();
            }

        }
        catch
        {
            errorCarga = "No se pudieron cargar los datos.";
        }
        finally
        {
            cargando = false;
        }
    }


    private async Task GuardarVehiculo()
    {
        if (guardando)
            return;

        guardando = true;
        errorGuardado = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            vehiculo.Modelo = Regex.Replace(vehiculo.Modelo.Trim(),@"\s+"," ");


            vehiculo.Patente =
                string.IsNullOrWhiteSpace(vehiculo.Patente)
                ? null
                : vehiculo.Patente.Trim().ToUpperInvariant();

            bool existeMarca = await db.Marcas
                .AnyAsync(m => m.Id == vehiculo.MarcaId);

            if (!existeMarca)
            {
                errorGuardado =
                    "La marca seleccionada no existe.";
                return;
            }

            if (vehiculo.Patente != null)
            {
                bool patenteRepetida = await db.Vehiculos
                    .AnyAsync(v =>
                        v.Patente == vehiculo.Patente &&
                        v.Id != vehiculo.Id);

                if (patenteRepetida)
                {
                    errorGuardado =
                        "Ya existe otro vehículo con esa patente.";
                    return;
                }
            }

            if (Id.HasValue)
            {
                // EDITAR un vehículo existente

                var existente = await db.Vehiculos
                    .FindAsync(Id.Value);

                if (existente is null)
                {
                    errorGuardado =
                        "El vehículo ya no existe.";
                    return;
                }

                existente.MarcaId = vehiculo.MarcaId;
                existente.Modelo = vehiculo.Modelo;
                existente.Anio = vehiculo.Anio;
                existente.Precio = vehiculo.Precio;
                existente.EsUsado = vehiculo.EsUsado;
                existente.Kilometraje = vehiculo.Kilometraje;
                existente.Patente = vehiculo.Patente;
            }
            else
            {
                // AGREGAR un vehículo nuevo

                db.Vehiculos.Add(vehiculo);
            }

            await db.SaveChangesAsync();

            VehiculosState.NotificarCambio("Vehículo guardado correctamente.");

            Navigation.NavigateTo("/vehiculos");

        }
        catch (DbUpdateException)
        {
            errorGuardado =
                "No se pudo guardar. Verificá que la patente no esté repetida.";
        }
        catch
        {
            errorGuardado =
                "Ocurrió un error al guardar el vehículo.";
        }
        finally
        {
            guardando = false;
        }

    }


    private void Volver()
    {
        Navigation.NavigateTo("/vehiculos");
    }
}
